--[[
    Script Manager - SPWN (Versão Definitiva com Fila + Varredura de Memória)
    Identifica scripts executados antes ou depois do Gerenciador automaticamente.
--]]

local ScriptManager = {}
ScriptManager.__index = ScriptManager

local RegisteredScripts = {}
local UIListFrame = nil
local SearchBox = nil
local MainFrame = nil
local ScreenGuiRef = nil

