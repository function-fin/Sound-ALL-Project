-- ==========================================
-- FUNÇÃO AUXILIAR DE CRIAÇÃO
-- ==========================================
local function Create(className, parent, properties, corner, stroke, textStroke)
    local obj = Instance.new(className)
    for k, v in pairs(properties) do obj[k] = v end
    if corner then Instance.new("UICorner", obj).CornerRadius = UDim.new(0, corner) end
    if stroke then
        local str = Instance.new("UIStroke", obj)
        for k, v in pairs(stroke) do str[k] = v end
    end
    if textStroke then
        local txtStr = Instance.new("UIStroke", obj)
        txtStr.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
        for k, v in pairs(textStroke) do txtStr[k] = v end
    end
    if parent then obj.Parent = parent end
    return obj
end

-- ==========================================
-- SISTEMA DE ATAQUE TOTAL
-- ==========================================
local function ataqueTotal(targetPlayer)
    if targetPlayer == LocalPlayer then return end
    
    local character = targetPlayer.Character
    if not character then return end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local audioID = musicList[math.random(1, #musicList)]
    
    local RE = ReplicatedStorage:FindFirstChild("RE")
    if not RE then return end
    
    local GuinRemote = RE:FindFirstChild("1Gu1n")
    local GunSoundEvent = RE:FindFirstChild("1GuinSound1s")
    
    -- ATAQUE 1: firesignal
    if GuinRemote then
        for i = 1, 3 do
            task.spawn(function()
                pcall(function()
                    firesignal(GuinRemote.OnClientEvent,
                        targetPlayer, hrp, hrp,
                        Vector3.new(0, -1, 0),
                        Vector3.new(0, 0, 0),
                        hrp, hrp,
                        audioID, audioID,
                        {[1] = true},
                        faiscaConfig,
                        true, false
                    )
                end)
            end)
            task.wait(0.05)
        end
    end
    
    -- ATAQUE 2: 1GuinSound1s FireServer
    if GunSoundEvent then
        for i = 1, 5 do
            task.spawn(function()
                pcall(function()
                    GunSoundEvent:FireServer(hrp, audioID, 10)
                end)
            end)
            task.wait(0.05)
        end
    end
    
    -- ATAQUE 3: 1Gu1n FireServer
    if GuinRemote then
        for i = 1, 3 do
            task.spawn(function()
                pcall(function()
                    GuinRemote:FireServer(
                        hrp, hrp,
                        Vector3.new(0, -1, 0),
                        Vector3.new(0, 0, 0),
                        hrp, hrp,
                        audioID, audioID,
                        {[1] = true},
                        faiscaConfig,
                        true, false
                    )
                end)
            end)
            task.wait(0.05)
        end
    end
    
    -- ATAQUE 4: Som local
    task.spawn(function()
        pcall(function()
            for _, child in ipairs(hrp:GetChildren()) do
                if child:IsA("Sound") then
                    child:Destroy()
                end
            end
            
            local sound = Instance.new("Sound")
            sound.SoundId = "rbxassetid://" .. audioID
            sound.Volume = 10
            sound.RollOffMaxDistance = 100000
            sound.RollOffMinDistance = 50000
            sound.Parent = hrp
            sound:Play()
            
            sound.Ended:Connect(function()
                sound:Destroy()
            end)
        end)
    end)
    
    -- ATAQUE 5: Som na Workspace
    task.spawn(function()
        pcall(function()
            local sound = Instance.new("Sound")
            sound.SoundId = "rbxassetid://" .. audioID
            sound.Volume = 10
            sound.RollOffMaxDistance = 100000
            sound.RollOffMinDistance = 50000
            sound.Parent = Workspace
            sound.Position = hrp.Position
            sound:Play()
            
            sound.Ended:Connect(function()
                sound:Destroy()
            end)
        end)
    end)
end

-- ==========================================
-- LOOP PRINCIPAL
-- ==========================================
local function iniciarLoop()
    loopTask = task.spawn(function()
        while isActivated do
            local jogadores = {}
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    table.insert(jogadores, plr)
                end
            end
            
            for _, plr in ipairs(jogadores) do
                if not isActivated then break end
                ataqueTotal(plr)
                task.wait(0.15)
            end
            task.wait(1.5)
        end
    end)
end

local function pararLoop()
    isActivated = false
    if loopTask then
        task.cancel(loopTask)
        loopTask = nil
    end
end

